{
  "name": "legacyx-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently -n frontend,backend -c blue,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build:backend": "npm run build --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "test:backend": "npm test --prefix backend",
    "install:backend": "npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
