# --- RPCs -----------------------------------------------------------------
FLARE_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Deployer -----------------------------------------------------------
PRIVATE_KEY=0x...

# --- LayerZero V2 -----------------------------------------------------------
# Verify current addresses/eids before deploying:
# https://docs.layerzero.network/v2/deployments/deployed-contracts
LZ_ENDPOINT_FLARE_COSTON2=
LZ_EID_FLARE_COSTON2=
LZ_ENDPOINT_BASE_SEPOLIA=
LZ_EID_BASE_SEPOLIA=

# --- Vault asset (must be an OFT, or an OFT adapter wrapping the token, so
# cross-chain claims can bridge). FXRP is already deployed as a LayerZero OFT
# Adapter on Coston2 per https://dev.flare.network/fxrp/oft — verify current
# address before deploying:
ASSET_FLARE_COSTON2=0xCd3d2127935Ae82Af54Fc31cCD9D3440dbF46639
ASSET_BASE_SEPOLIA=

# --- Vault config ---------------------------------------------------------
VAULT_OWNER=
VAULT_NAME="LegacyX Estate"
VAULT_INACTIVITY_DAYS=365
TRUSTED_VERIFIER=

# --- Addresses filled in after each deploy step (used by later scripts) ----
RELAY_FLARE_COSTON2=
RELAY_BASE_SEPOLIA=

# --- OTC settlement ---------------------------------------------------------
OTC_QUOTE_TOKEN=
OTC_MATCHER=
