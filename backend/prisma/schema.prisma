// LegacyX backend data model — Private OTC Marketplace
//
// Scope: this is the only piece of the app that talks to a backend. Vault
// creation, beneficiaries, inheritance conditions, and claims are handled
// entirely client-side (wallet + localStorage) by the frontend now — see
// frontend/src/components/wallet/VaultDataProvider.jsx. The contract this
// schema serves is frontend/API_CONTRACT.md.
//
// SQLite is used for zero-config hackathon development. To move to Postgres
// for a shared/staging environment: change `provider` to "postgresql", point
// DATABASE_URL at a Postgres instance, and re-run `npm run prisma:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OtcOrder {
  // Internal sequential id, used only to derive the public "LX-XXXX" id
  // (see src/utils/publicId.ts) — never exposed directly.
  seq Int @id @default(autoincrement())

  /// One of: FXRP | FLR | C2FLR
  asset String

  // Amount and prices are decimal strings (not floats) to avoid precision
  // loss — see src/utils/decimal.ts for safe parsing/comparison.
  amount String

  minPrice String

  sellerAddress String
  buyerAddress  String?
  matchedPrice  String?

  /// One of: pending | matched | settled | cancelled
  status String @default("pending")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  matchedAt DateTime?

  settlement OtcSettlement?

  @@map("otc_orders")
}

model OtcSettlement {
  id String @id @default(cuid())

  orderSeq Int      @unique
  order    OtcOrder @relation(fields: [orderSeq], references: [seq])

  asset  String
  amount String
  price  String
  txHash String

  settledAt DateTime @default(now())

  @@map("otc_settlements")
}

// Single-row table holding the simulated market price. Nudged periodically
// by a background tick (src/services/stats.service.ts) so GET /api/stats
// has something to show without a real Flare/FTSO price feed integration.
model MarketStat {
  id        Int      @id @default(1)
  priceUsd  Float
  updatedAt DateTime @updatedAt

  @@map("market_stats")
}
