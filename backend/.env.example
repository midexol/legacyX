NODE_ENV=development
PORT=4000

# Postgres connection string. For local dev, either run a local Postgres or
# point this at a free Render Postgres instance's "External Database URL"
# (Render dashboard -> your database -> Connect). In production this is set
# automatically by render.yaml from the linked database resource.
DATABASE_URL="postgresql://user:password@localhost:5432/legacyx?schema=public"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=change-me-too
VERIFICATION_INTERVAL_SECONDS=30
MATCHING_INTERVAL_SECONDS=15
FRONTEND_ORIGIN=http://localhost:5173

# Public Marketplace (frontend/API_CONTRACT.md) simulated matching delays —
# see backend/README.md's "Public Marketplace API" section. Lower these for
# faster demos.
MARKETPLACE_MATCH_DELAY_MS=20000
MARKETPLACE_SETTLE_DELAY_MS=20000

# --- Chain integration (contracts/ — LegacyVault) ---------------------------
# Optional. Vaults without a linked contractAddress (see POST
# /api/vaults/:id/link-chain) keep using the pure off-chain simulation in
# src/utils/mockChain.ts; nothing below is required until you link one.
#
# JSON object mapping chainId -> RPC URL, e.g. Flare Coston2 is chainId 114:
# RPC_URL_BY_CHAIN_ID={"114":"https://coston2-api.flare.network/ext/C/rpc"}
RPC_URL_BY_CHAIN_ID=

# Signs only the actions LegacyVault allows a third party to submit: sweeping
# an elapsed INACTIVITY window, and relaying a beneficiary's/approver's own
# off-chain signature into approveCondition. Never used for owner-only
# actions (deposit/withdraw/pingHeartbeat/claim stay wallet-signed by the
# user, so they're not wired up here).
OPERATOR_PRIVATE_KEY=

# Separate key with the authority to unilaterally satisfy a MANUAL_APPROVAL /
# LEGAL_DOCUMENT condition on-chain (contracts/src/LegacyVault.sol's
# trustedVerifier). Keep this distinct from OPERATOR_PRIVATE_KEY.
TRUSTED_VERIFIER_PRIVATE_KEY=
